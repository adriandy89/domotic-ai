# Contexto de build de las imágenes del BACKEND (Dockerfile raíz).
# Solo necesita: apps/ libs/ prisma/ prisma.config.ts package.json pnpm-lock.yaml
# nest-cli.json tsconfig*.json webpack.config.js. Todo lo demás se excluye para que
# el contexto sea pequeño y no se cuelen secretos ni artefactos del host.

# Dependencias y salidas de build (en cualquier nivel)
**/node_modules
**/dist
build
.next
out
coverage
.nyc_output
# El cliente Prisma se regenera dentro de la imagen (evita copiar uno desfasado)
generated

# Secretos / entorno (nunca dentro de la imagen)
.env
.env.*
**/.env
**/.env.*

# Otros proyectos con su propio contexto/Dockerfile
web
web-zigbee2mqtt
stack-client
stack-docker
stack-tbmq
alexa-lambda

# Herramientas, documentación y scripts de desarrollo
.claude
.github
.gitlab-ci.yml
.vscode
.idea
.git
.gitignore
.dockerignore
Dockerfile*
docker-compose*.yml
*.md
docs
assets
scripts
Makefile
deploy-batched.sh
start-ngrok.sh

# Logs / temporales / SO
logs
*.log
npm-debug.log
yarn-error.log
pnpm-debug.log
tmp
temp
*.tmp
*.swp
*.swo
*~
.DS_Store
Thumbs.db
