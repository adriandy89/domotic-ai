# =============================================================================
# Entorno de DESARROLLO LOCAL AISLADO  (cp .env.dev.example .env.dev)
#
# Lo usa scripts/dev/run.sh (make dev-api, dev-core, ...). Ese script primero
# VACÍA todas las claves de .env y luego carga este fichero, así que nada de
# .env (que puede apuntar a producción) se filtra. Además se niega a arrancar si
# la BD, Redis, NATS, MQTT o PUBLIC_APP_URL no son localhost.
#
# Infra: make dev-up  (stack-docker + overlay docker-compose.dev.yml)
# =============================================================================
NODE_ENV=development
API_PORT=3003
SWAGGER_ENABLE=true
COOKIE_DOMAIN=
# Origen del front local (vite)
PUBLIC_APP_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# --- Base de datos: BD propia `domotic_dev` en el Timescale de stack-docker ----
# (no toca tu BD `domotic`). Crear + migrar: make dev-db
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/domotic_dev?schema=public&connection_limit=10"
MASTRA_DATABASE_URL="postgresql://postgres:postgres@localhost:5433/mastra_dev"

# --- Redis del overlay dev (puerto 6380; password = la de stack-docker) --------
REDIS_URL=redis://localhost:6380
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_CACHE_TTL=86400000

# --- NATS del overlay dev (dc.sh usa estas credenciales para el contenedor) ----
NATS_URL=nats://localhost:4222
NATS_USER=admin
NATS_PASS=

# --- MQTT: Mosquitto local anónimo. NUNCA el broker de producción --------------
MQTT_SERVER_BASE=mqtt://localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=domotic-dev-mqtt-core
MQTT_APPLIANCE_MONITOR_CLIENT_ID=domotic-dev-appliance-monitor
MQTT_APPLIANCE_MONITOR_USERNAME=
MQTT_APPLIANCE_MONITOR_PASSWORD=
MQTT_CONNECT_TIMEOUT=10000
MQTT_RECONNECT_PERIOD=4000
# Sin API admin de TBMQ: crear/borrar casas no toca credenciales reales.
MQTT_SERVER_API=http://127.0.0.1:9
MQTT_SERVER_WEB_USER=
MQTT_SERVER_WEB_PASS=

# --- Secretos SOLO de desarrollo (genera con: openssl rand -hex 32) -----------
SESSION_SECRET=
INTEGRATIONS_ENCRYPTION_KEY=
EDGE_SIGNING_SECRET=

# --- OAuth: valores ficticios para que Passport arranque. Para login real con
# el navegador, usa una app OAuth de desarrollo con callback a localhost. Para
# pruebas automatizadas usa: make dev-session (crea usuario + cookie de sesión).
GOOGLE_CLIENT_ID=dev-dummy
GOOGLE_CLIENT_SECRET=dev-dummy
GOOGLE_CALLBACK_URL=http://localhost:3003/api/v1/auth/google/callback
MICROSOFT_CLIENT_ID=dev-dummy
MICROSOFT_CLIENT_SECRET=dev-dummy
MICROSOFT_TENANT_ID=common
MICROSOFT_CALLBACK_URL=http://localhost:3003/api/v1/auth/microsoft/callback
GITHUB_CLIENT_ID=dev-dummy
GITHUB_CLIENT_SECRET=dev-dummy
GITHUB_CALLBACK_URL=http://localhost:3003/api/v1/auth/github/callback

# --- Servicios externos DESACTIVADOS en local ---------------------------------
EMAIL_USER=
EMAIL_PASS=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_LINK=
TELEGRAM_ADMIN_CHAT_IDS=
ESIOS_API_TOKEN=
ENTSOE_API_TOKEN=
PRICING_BACKFILL_DAYS=0
EMBEDDING_OPENAI_API_KEY=

# --- Jobs ----------------------------------------------------------------------
SENSOR_DEDUP_ENABLED=false
DEVICE_OFFLINE_AFTER_HOURS=24
WATCHDOG_INTERVAL_SECONDS=60
INTEGRATIONS_DEBUG_TOOL_IO=false
