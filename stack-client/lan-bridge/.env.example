# ── Required ─────────────────────────────────────────────────────────────────
# Same home unique id the rest of the stack uses (see dashboard → Homes).
HOME_UNIQUE_ID=

# ── MQTT (local mosquitto, bridged to TBMQ) ──────────────────────────────────
# The bridge runs with HOST networking (required for SSDP discovery and
# Wake-on-LAN — Docker networks can't be combined with network_mode: host).
# It therefore reaches mosquitto through the port the edge stack publishes to
# the host (1883:1883) — NOT through a Docker-network hostname like
# "mosquitto", which does not resolve in host mode.
MQTT_URL=mqtt://127.0.0.1:1883
MQTT_USERNAME=
MQTT_PASSWORD=
# MQTT_CLIENT_ID=<HOME_UNIQUE_ID>-lan-bridge

# ── Devices ──────────────────────────────────────────────────────────────────
# You normally DON'T need this: pair TVs from the dashboard instead (turn ON
# "Pairing mode" on the LAN Bridge card and accept the prompt on the TV). The
# paired registry persists in DATA_DIR/devices.json.
#
# DEVICES is an optional JSON-array SEED for static setups; entries are added
# once if their id is not already in the registry. "mac" enables Wake-on-LAN
# power-on (auto-detected when pairing; enable "LG Connect Apps" on the TV).
# Alternatively point DEVICES_FILE to a JSON file with the same array.
# DEVICES=[{"type":"webos","id":"tv_salon","name":"TV Salón","ip":"192.168.1.50","mac":"AA:BB:CC:DD:EE:FF"}]
# DEVICES_FILE=/data/devices.json

# ── Storage & discovery ──────────────────────────────────────────────────────
# Pairing keys are persisted here — mount a volume in Docker.
DATA_DIR=/data
# Periodic SSDP scan that logs TVs found on the LAN but not yet configured.
DISCOVERY_ENABLED=true
